# Copy to .env and replace every placeholder before deployment.
DB_PASSWORD=ChangeThis_123!
FRONTEND_URL=https://menu.example.com
SESSION_SECURE=true
APP_PORT=8080

# Required for AI analysis in production.
GEMINI_API_KEY=replace-with-a-server-side-secret
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Keep mock payment disabled outside local development.
PAYMENT_MOCK_ENABLED=false
PAYMENT_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
